# Copy this file to .env for a persistent local configuration. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./medical_sharing.db
JWT_SECRET=replace-with-a-random-48-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-48-plus-character-secret
# Generate MASTER_KEY with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SECURE_COOKIES=false
MFA_TEST_MODE=true
MFA_TEST_OTP=000000
EMERGENCY_ACCESS_ENABLED=true
INITIAL_ADMIN_PASSWORD=replace-with-a-secure-password-min-12-chars
AUTO_CREATE_SCHEMA=true

# Storage: 'local' is the default. Select 'ipfs' only when the IPFS daemon is running.
STORAGE_PROVIDER=local
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/

# Blockchain: 'development' writes a local cryptographic ledger. 'web3' connects to EVM / Besu.
BLOCKCHAIN_PROVIDER=development
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_WALLET_ADDRESS=

# Async Tasks (Optional Celery / Redis worker)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
