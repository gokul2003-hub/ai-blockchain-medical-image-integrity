# Local tooling (portable broker binaries) - not part of the source tree
.tools/

# Runtime secrets and data
# .env and friends are never committed; .env.example (safe placeholders) is kept.
.env
.env.*
!.env.example
backend/.dev-secrets.json
.dev-secrets.json
*.pem
*.key
id_rsa
id_rsa.pub
*.db
*.db-journal
*.bak.db
backend/venv/
venv/
backend/.pytest_cache/
.pytest_cache/

# Runtime artifacts
backend/storage/
backend/blockchain_artifacts/
blockchain/artifacts/
blockchain/cache/
# Per-run audit output of scripts/prune_orphan_ledger.py (see docs/LEDGER_COMPACTION.md)
backend/blockchain_compaction_report.json
**/__pycache__/
*.pyc
node_modules/
frontend/dist/
*.log

# Local archives - never part of the source tree
*.zip
*.tar.gz
*.rar